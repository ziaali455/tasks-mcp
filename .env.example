GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional locally; on Render these are derived from RENDER_EXTERNAL_URL automatically.
# PUBLIC_BASE_URL=http://localhost:8000
# GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback
# Password required at this server's own /login page before an MCP client
# (Claude/ChatGPT) can get a token for /mcp. Leave unset only for local testing.
MCP_AUTH_TOKEN=
TOKEN_STORE_PATH=./token_store.json
PORT=8000
